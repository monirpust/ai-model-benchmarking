# Copy to .env and fill in the providers you want to use. Mock models need no keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Any OpenAI-compatible server, e.g. Ollama:
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_API_KEY=
# Web server
PORT=3000
# Optional access code required for senior judges
GENBENCH_SENIOR_CODE=
# Where runs are stored (default ./runs)
GENBENCH_RUNS_DIR=
